249 0 obj
<< /K [ 12 ] /P 122 0 R /Pg 15 0 R /S /Figure /Type /StructElem >>
endobj
250 0 obj
<< /E (Amor e Relacionamentos) /K [ 3 ] /Pg 15 0 R /S /H2 /T (Amor e Relacionamentos) /Type /StructElem >>
endobj
251 0 obj
<< /ActualText (Quando se trata de amor, Escorpião não brinca. Para este signo, um relacionamento é mais do que apenas companhia \205 é uma conexão profunda e transformadora. Os escorpianos não têm medo de se entregar completamente, e é exatamente isso que eles esperam em troca. Superficialidade não tem vez. Se você deseja se conectar verdadeiramente com alguém de Escorpião, prepare-se para um mergulho intenso nas águas mais profundas das emoções.) /K [ 1 ] /Pg 15 0 R /S /P /Type /StructElem >>
endobj
252 0 obj
<< /E (A Intensa Paixão Escorpiana) /K [ 5 ] /Pg 15 0 R /S /H2 /T (A Intensa Paixão Escorpiana) /Type /StructElem >>
endobj
253 0 obj
<< /K [ 13 ] /P 122 0 R /Pg 15 0 R /S /Figure /Type /StructElem >>
endobj
254 0 obj
<< /ActualText (Escorpião ama com todo o coração \205 e com toda a alma. Quando encontram alguém que consideram digno de sua confiança e amor, eles se dedicam inteiramente. Sua paixão é magnética e envolvente, criando uma ligação que muitas vezes é difícil de esquecer. Para eles, o amor é um espaço onde se vive intensamente, com emoção, desejo e uma busca constante por conexão verdadeira.) /K [ 4 ] /Pg 15 0 R /S /P /Type /StructElem >>
endobj
255 0 obj
<< /E (Lealdade e Proteção) /K [ 8 ] /Pg 15 0 R /S /H2 /T (Lealdade e Proteção) /Type /StructElem >>
endobj
256 0 obj
<< /K [ 14 ] /P 122 0 R /Pg 15 0 R /S /Figure /Type /StructElem >>
endobj
257 0 obj
<< /K [ 15 ] /P 122 0 R /Pg 15 0 R /S /Figure /Type /StructElem >>
endobj
258 0 obj
<< /ActualText (Uma vez comprometido, Escorpião é leal ao extremo. Proteger aqueles que ama é uma prioridade absoluta. No entanto, essa lealdade também vem com altas expectativas \205 eles esperam a mesma intensidade e dedicação. Quando esses elementos estão presentes, Escorpião se torna um parceiro profundamente amoroso e dedicado.) /K [ 7 ] /Pg 15 0 R /S /P /Type /StructElem >>
endobj
259 0 obj
<< /K [ 9 ] /P 122 0 R /Pg 15 0 R /S /Figure /Type /StructElem >>
endobj
