endobj
234 0 obj
<< /ActualText (Lealdade Profunda: Escorpianos valorizam relacionamentos verdadeiros e são fiéis àqueles que conquistam sua confiança.) /K [ 1 ] /P 628 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
235 0 obj
<< /ActualText (Coragem Inabalável: Enfrentam desafios com força e resiliência, mesmo nas situações mais difíceis.) /K [ 2 ] /P 629 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
236 0 obj
<< /ActualText (Capacidade de Transformação: Como o símbolo da Fênix, Escorpião tem a habilidade de renascer após momentos de crise, mais forte e sábio.) /K [ 3 ] /P 630 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
237 0 obj
<< /ActualText (Intuição Afiada: Têm um sexto sentido poderoso e costumam perceber o que os outros sentem ou pensam, mesmo que não seja dito.) /K [ 4 ] /P 631 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
238 0 obj
<< /E (Desafios de Escorpião) /K [ 9 ] /Pg 14 0 R /S /H1 /T (Desafios de Escorpião) /Type /StructElem >>
endobj
239 0 obj
<< /K [ 13 ] /P 121 0 R /Pg 14 0 R /S /Figure /Type /StructElem >>
endobj
240 0 obj
<< /ActualText (Ciúmes e Controle: Sua intensidade emocional pode levá-los a serem possessivos ou controladores, especialmente em relacionamentos.) /K [ 6 ] /P 632 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
241 0 obj
<< /ActualText (Dificuldade em Perdoar: Quando se sentem traídos, podem guardar rancor por muito tempo.) /K [ 7 ] /P 633 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
242 0 obj
<< /ActualText (Tendência ao Extremismo: Muitas vezes, Escorpião vive em extremos \205 tudo ou nada, amor ou ódio, confiança total ou desconfiança absoluta.) /K [ 8 ] /P 634 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
