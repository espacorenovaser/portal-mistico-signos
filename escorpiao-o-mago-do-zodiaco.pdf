<< /ActualText (01) /K [ 2 ] /Pg 12 0 R /S /P /Type /StructElem >>
endobj
204 0 obj
<< /E (Regência de Plutão e Marte) /K [ 1 ] /Pg 12 0 R /S /H1 /T (Regência de Plutão e Marte) /Type /StructElem >>
endobj
205 0 obj
<< /K [ 9 ] /P 119 0 R /Pg 12 0 R /S /Figure /Type /StructElem >>
endobj
206 0 obj
<< /ActualText (Plutão, o planeta da transformação, traz a Escorpião a capacidade de se reinventar e de transformar qualquer dificuldade em força. Já Marte, como regente tradicional, fornece coragem, determinação e a energia necessária para perseguir seus objetivos. Essa combinação torna Escorpião um signo que não apenas sobrevive aos desafios, mas os utiliza como combustível para crescer.) /K [ 0 ] /Pg 12 0 R /S /P /Type /StructElem >>
endobj
207 0 obj
<< /E (A Energia de Escorpião) /K [ 4 ] /Pg 12 0 R /S /H1 /T (A Energia de Escorpião) /Type /StructElem >>
endobj
208 0 obj
<< /K [ 10 ] /P 119 0 R /Pg 12 0 R /S /Figure /Type /StructElem >>
endobj
209 0 obj
<< /ActualText (A energia de Escorpião é profunda, transformadora e magnética. Marcada por intensidade emocional, coragem e resiliência, busca a verdade nas profundezas e renasce das próprias sombras. É uma força de mudança, conexão intuitiva e regeneração, que enfrenta desafios com determinação e paixão.) /K [ 3 ] /Pg 12 0 R /S /P /Type /StructElem >>
endobj
210 0 obj
<< /E (Período) /K [ 6 ] /Pg 12 0 R /S /H1 /T (Período) /Type /StructElem >>
endobj
211 0 obj
<< /K [ 11 ] /P 119 0 R /Pg 12 0 R /S /Figure /Type /StructElem >>
endobj
212 0 obj
<< /ActualText (De 23 de outubro a 21 de novembro, Escorpião chega ao zodíaco com a força do outono no Hemisfério Norte e da primavera no Hemisfério Sul. É o momento de mudança e renovação \205 exatamente o que define este signo.) /K [ 5 ] /Pg 12 0 R /S /P /Type /StructElem >>
endobj
