346 0 obj
<< /E (Compatibilidade com Outros Signos) /K [ 2 ] /Pg 22 0 R /S /H2 /T (Compatibilidade com Outros Signos) /Type /StructElem >>
endobj
347 0 obj
<< /ActualText (Áries, com sua energia intensa e personalidade assertiva, pode despertar admiração e desafios em igual medida nos relacionamentos. Sua abordagem direta e apaixonada é contagiante, mas nem todos conseguem acompanhar o ritmo do Carneiro. No amor, na amizade ou no trabalho, a compatibilidade de Áries com outros signos depende de como eles lidam com sua energia vibrante e sua necessidade de liberdade.) /K [ 0 ] /Pg 22 0 R /S /P /Type /StructElem >>
endobj
348 0 obj
<< /E (Desafios no Amor) /K [ 3 ] /Pg 22 0 R /S /H3 /T (Desafios no Amor) /Type /StructElem >>
endobj
349 0 obj
<< /K [ 12 ] /P 143 0 R /Pg 22 0 R /S /Figure /Type /StructElem >>
endobj
350 0 obj
<< /ActualText (Câncer:) /Alt () /K [ 5 ] /Pg 22 0 R /S /P /Type /StructElem >>
endobj
351 0 obj
<< /ActualText (Áries e Câncer vivem em mundos emocionais diferentes. Enquanto Áries é direto e impulsivo, Câncer é sensível e precisa de segurança emocional. Arianos podem achar o ritmo de Câncer muito lento, enquanto os cancerianos podem se sentir sobrecarregados pela intensidade de Áries. A harmonia aqui exige paciência e empatia de ambos os lados.) /Alt () /K [ 6 ] /Pg 22 0 R /S /P /Type /StructElem >>
endobj
352 0 obj
<< /ActualText (Capricórnio:) /Alt () /K [ 7 ] /Pg 22 0 R /S /P /Type /StructElem >>
endobj
353 0 obj
<< /ActualText (Capricórnio é prático e cauteloso, o oposto da natureza impetuosa de Áries. Essa combinação pode gerar atrito, pois Capricórnio prefere pensar antes de agir, enquanto Áries pula direto na ação. No entanto, se conseguirem valorizar suas diferenças, podem formar uma parceria equilibrada, onde um ensina o outro.) /Alt () /K [ 8 ] /Pg 22 0 R /S /P /Type /StructElem >>
endobj
