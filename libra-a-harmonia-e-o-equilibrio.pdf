<< /K [ 329 0 R 10 ] /P 129 0 R /Pg 21 0 R /S /Figure /Type /StructElem >>
endobj
332 0 obj
<< /K [ 11 ] /P 129 0 R /Pg 21 0 R /S /Figure /Type /StructElem >>
endobj
333 0 obj
<< /K [ 9 ] /P 130 0 R /Pg 22 0 R /S /Figure /Type /StructElem >>
endobj
334 0 obj
<< /ActualText (06) /K [ 0 ] /Pg 22 0 R /S /P /Type /StructElem >>
endobj
335 0 obj
<< /E (Atividades que Restauram o Equilíbrio) /K [ 5 ] /Pg 22 0 R /S /H1 /T (Atividades que Restauram o Equilíbrio) /Type /StructElem >>
endobj
336 0 obj
<< /K [ 10 ] /P 130 0 R /Pg 22 0 R /S /Figure /Type /StructElem >>
endobj
337 0 obj
<< /ActualText (Libra é um signo regido por Vênus, o que significa que aprecia tudo o que é belo e harmonioso. Atividades ligadas à arte e à estética são uma excelente forma de autocuidado. Visitar uma exposição de arte, ouvir música relaxante ou até redecorar um espaço da casa pode ser profundamente revigorante.) /Alt () /K [ 6 ] /Pg 22 0 R /S /P /Type /StructElem >>
endobj
338 0 obj
<< /ActualText (Práticas que combinam movimento e serenidade, como yoga, tai chi ou caminhadas ao ar livre, são ideais para Libra. Esses momentos de conexão consigo mesmo ajudam a equilibrar a energia e a clarear a mente, especialmente quando a indecisão começa a pesar.) /Alt () /K [ 7 ] /Pg 22 0 R /S /P /Type /StructElem >>
endobj
339 0 obj
<< /E (Cuidados Sociais e Pessoais) /K [ 4 ] /Pg 22 0 R /S /H1 /T (Cuidados Sociais e Pessoais) /Type /StructElem >>
endobj
