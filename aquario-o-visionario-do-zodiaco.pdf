<< /K [ 10 ] /P 122 0 R /Pg 14 0 R /S /Figure /Type /StructElem >>
endobj
231 0 obj
<< /ActualText (02) /K [ 0 ] /Pg 14 0 R /S /P /Type /StructElem >>
endobj
232 0 obj
<< /E (Os Desafios de Aquário) /K [ 5 ] /Pg 14 0 R /S /H1 /T (Os Desafios de Aquário) /Type /StructElem >>
endobj
233 0 obj
<< /K [ 11 ] /P 122 0 R /Pg 14 0 R /S /Figure /Type /StructElem >>
endobj
234 0 obj
<< /ActualText (Nem tudo é simples quando se trata de um aquariano. Sua independência e foco no futuro podem, às vezes, torná-los desconectados do presente ou das necessidades emocionais mais imediatas de quem está ao seu redor.) /K [ 1 ] /Pg 14 0 R /S /P /Type /StructElem >>
endobj
235 0 obj
<< /ActualText (Distância Emocional: Aquário nem sempre se conecta profundamente em um nível emocional, o que pode fazê-los parecer frios ou indiferentes.) /K [ 2 ] /P 631 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
236 0 obj
<< /ActualText (Rebeldia: Eles resistem a qualquer coisa que sintam como uma limitação ou obrigação desnecessária.) /K [ 3 ] /P 632 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
237 0 obj
<< /ActualText (Idealismo Exagerado: Muitas vezes, Aquário acredita tanto em suas ideias que pode ignorar as dificuldades práticas para realizá-las.) /K [ 4 ] /P 633 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
238 0 obj
<< /E (Aquário em Essência) /K [ 6 ] /Pg 14 0 R /S /H1 /T (Aquário em Essência) /Type /StructElem >>
endobj
239 0 obj
<< /K [ 12 ] /P 122 0 R /Pg 14 0 R /S /Figure /Type /StructElem >>
endobj
240 0 obj
<< /ActualText (A personalidade aquariana é fascinante porque mistura o desejo de mudança com a necessidade de liberdade. Eles não vivem para seguir regras, mas para criar caminhos próprios. Se você convive com um aquariano, provavelmente já sentiu o impacto de sua mente visionária e suas ideias inspiradoras. Este é um signo que vive para fazer a diferença \205 e raramente passa despercebido.) /K [ 7 ] /Pg 14 0 R /S /P /Type /StructElem >>
endobj
241 0 obj
<< /ActualText (No próximo capítulo, vamos explorar como essa personalidade impacta os relacionamentos e como Aquário se comporta no amor.) /K [ 8 ] /Pg 14 0 R /S /P /Type /StructElem >>
endobj
242 0 obj
<< /K [ 9 ] /P 122 0 R /Pg 14 0 R /S /Figure /Type /StructElem >>
endobj
