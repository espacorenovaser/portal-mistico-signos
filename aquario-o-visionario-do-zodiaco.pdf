220 0 obj
<< /E (A Personalidade Aquariano ) /K [ 6 ] /Pg 13 0 R /S /H2 /T (A Personalidade Aquariano ) /Type /StructElem >>
endobj
221 0 obj
<< /ActualText (A Mente do Futuro: Aquário é o signo da inovação, da liberdade e das ideias à frente do seu tempo. Aquarianos são pensadores independentes que adoram questionar o que é dado como certo, buscando novas perspectivas para entender e transformar o mundo. Sua personalidade é marcada por uma mistura única de racionalidade e idealismo. Eles não apenas sonham com um futuro melhor, mas também trabalham para criá-lo.) /K [ 1 ] /Pg 13 0 R /S /P /Type /StructElem >>
endobj
222 0 obj
<< /E (Os Pontos Fortes de Aquário) /K [ 7 ] /Pg 13 0 R /S /H2 /T (Os Pontos Fortes de Aquário) /Type /StructElem >>
endobj
223 0 obj
<< /K [ 13 ] /P 121 0 R /Pg 13 0 R /S /Figure /Type /StructElem >>
endobj
224 0 obj
<< /ActualText (Os nativos de Aquário têm uma criatividade impressionante, especialmente quando se trata de resolver problemas ou encontrar formas diferentes de abordar desafios. Eles enxergam além do óbvio e conseguem unir ideias inovadoras com a capacidade de pensar no coletivo.) /K [ 2 ] /Pg 13 0 R /S /P /Type /StructElem >>
endobj
225 0 obj
<< /ActualText (Inovação: Aquário é sempre um passo à frente, imaginando o que ainda está por vir.) /K [ 3 ] /P 628 0 R /Pg 13 0 R /S /P /Type /StructElem >>
endobj
226 0 obj
<< /ActualText (Empatia Coletiva: Embora nem sempre demonstrem afeto de maneira tradicional, possuem um forte desejo de melhorar a vida das pessoas ao seu redor.) /K [ 4 ] /P 629 0 R /Pg 13 0 R /S /P /Type /StructElem >>
endobj
227 0 obj
<< /ActualText (Autenticidade: Não têm medo de ser diferentes e valorizam sua singularidade.) /K [ 5 ] /P 630 0 R /Pg 13 0 R /S /P /Type /StructElem >>
endobj
228 0 obj
<< /K [ 10 ] /P 121 0 R /Pg 13 0 R /S /Figure /Type /StructElem >>
endobj
