<< /E (Desafios da Personalidade) /K [ 6 ] /Pg 14 0 R /S /H1 /T (Desafios da Personalidade) /Type /StructElem >>
endobj
247 0 obj
<< /K [ 10 ] /P 129 0 R /Pg 14 0 R /S /Figure /Type /StructElem >>
endobj
248 0 obj
<< /ActualText (Como todo signo, Leão também tem suas sombras. Sua necessidade de reconhecimento pode, às vezes, ser confundida com arrogância. Além disso, a autoconfiança leonina pode torná-lo inflexível em situações onde ouvir e ceder são essenciais.) /K [ 1 ] /Pg 14 0 R /S /P /Type /StructElem >>
endobj
249 0 obj
<< /ActualText (Ego Exacerbado : A busca por aprovação pode levá-lo a exagerar nas suas qualidades ou querer estar sempre no centro das atenções.) /K [ 2 ] /P 632 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
250 0 obj
<< /ActualText (Dramatismo : Leoninos têm uma queda para transformar pequenos contratempos em grandes cenas.) /K [ 3 ] /P 633 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
251 0 obj
<< /ActualText (Teimosia : Quando acreditar estar certo, naturalmente abram mão de suas convicções.) /K [ 4 ] /P 634 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
252 0 obj
<< /E (O Leonino em Ação) /K [ 7 ] /Pg 14 0 R /S /H1 /T (O Leonino em Ação) /Type /StructElem >>
endobj
253 0 obj
<< /K [ 11 ] /P 129 0 R /Pg 14 0 R /S /Figure /Type /StructElem >>
endobj
254 0 obj
<< /ActualText (Apesar desses desafios, a força de Leão está em sua paixão pela vida e sua coragem de seguir seus sonhos. Com sua criatividade e capacidade de liderança, os leoninos tendem a ser pessoas que inspiram e deixam marcas profundas em tudo o que fazem.) /K [ 5 ] /P 635 0 R /Pg 14 0 R /S /P /Type /StructElem >>
endobj
255 0 obj
<< /K [ 8 ] /P 129 0 R /Pg 14 0 R /S /Figure /Type /StructElem >>
