208 0 obj
<< /E (Leão \205 Visão Geral ) /K [ 3 ] /Pg 11 0 R /S /H2 /T (Leão \205 Visão Geral ) /Type /StructElem >>
endobj
209 0 obj
<< /ActualText (Leão é o quinto signo do Zodíaco e é conhecido como o "Rei do Zodíaco" por um motivo: sua energia brilhante e magnética. Assim como o Sol, seu regente, Leão ilumina tudo ao seu redor, trazendo calor, vitalidade e inspiração. Nascidos entre 23 de julho e 22 de agosto, os leoninos carregam consigo uma força de liderança natural, um coração generoso e uma sede de viver intensamente.) /K [ 0 ] /Pg 11 0 R /S /P /Type /StructElem >>
endobj
210 0 obj
<< /E (Elemento Fogo) /K [ 4 ] /Pg 11 0 R /S /H2 /T (Elemento Fogo) /Type /StructElem >>
endobj
211 0 obj
<< /K [ 12 ] /P 126 0 R /Pg 11 0 R /S /Figure /Type /StructElem >>
endobj
212 0 obj
<< /ActualText (O elemento Fogo de Leão é uma das chaves para entender sua essência. Fogo é energia, paixão e criatividade, e Leão personifica isso em sua melhor forma. Sua presença é difícil de ignorar: leoninos são extrovertidos, confiantes e sempre prontos para dar um show, seja no palco da vida ou em momentos do cotidiano.) /K [ 1 ] /Pg 11 0 R /S /P /Type /StructElem >>
endobj
213 0 obj
<< /E (Planeta Regente: Sol) /K [ 7 ] /Pg 11 0 R /S /H3 /T (Planeta Regente: Sol) /Type /StructElem >>
endobj
214 0 obj
<< /K [ 13 ] /P 126 0 R /Pg 11 0 R /S /Figure /Type /StructElem >>
endobj
215 0 obj
<< /ActualText (O Sol, centro do sistema solar, representa o ego, a identidade e o propósito. Em Leão, ele brilha com intensidade máxima. Assim como o Sol dá vida ao planeta, o leonino tem a capacidade de inspirar e energizar as pessoas ao seu redor. No entanto, também exige reconhecimento e admiração \205 afinal, quem não gosta de ser apreciado pelo seu brilho?) /K [ 6 ] /Pg 11 0 R /S /P /Type /StructElem >>
endobj
